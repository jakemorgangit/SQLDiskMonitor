<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SQLDiskMonitor</AssemblyName>
    <RootNamespace>SQLDiskMonitor</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Fluent ThemeMode is flagged experimental; we rely on it for light/dark switching -->
    <NoWarn>$(NoWarn);WPF0001;MVVMTK0045</NoWarn>

    <AssemblyTitle>SQL Disk Monitor</AssemblyTitle>
    <Description>SQL Server storage performance, pressure and cost analysis. https://blackcat.wales</Description>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its namespace out of the global usings -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packages (SqlClient, SQLite, OxyPlot, WebView2, Azure.Identity…) come with the library. -->
    <ProjectReference Include="..\SQLDiskMonitor.Core\SQLDiskMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct reference so WebView2's build targets run for the exe as before (PDF export); same version as the library. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
