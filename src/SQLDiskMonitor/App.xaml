<Application x:Class="SQLDiskMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SQLDiskMonitor.Core;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SQLDiskMonitor.Core;component/Themes/Styles.xaml" />
                <!-- Converters, chart tracker and page templates (shared with hosts such as Blackcat Studio) -->
                <ResourceDictionary Source="pack://application:,,,/SQLDiskMonitor.Core;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Table" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource B.Border}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="FontSize" Value="12.5" />
                <!-- Theme-aware selection so selected rows stay readable in dark mode -->
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentSoft}" />
                                    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
