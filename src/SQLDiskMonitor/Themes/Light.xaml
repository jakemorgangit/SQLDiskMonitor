<!-- Light palette. Keys are referenced with DynamicResource so the theme can be switched at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="C.Accent">#0969DA</Color>
    <Color x:Key="C.AccentSoft">#DDEBFB</Color>
    <Color x:Key="C.Bg">#F4F6F9</Color>
    <Color x:Key="C.Border">#D8DEE4</Color>
    <Color x:Key="C.Crit">#CF222E</Color>
    <Color x:Key="C.Good">#1A7F37</Color>
    <Color x:Key="C.Grid">#ECEFF3</Color>
    <Color x:Key="C.High">#BC4C00</Color>
    <Color x:Key="C.Info">#0969DA</Color>
    <Color x:Key="C.Nav">#EBEEF3</Color>
    <Color x:Key="C.OnAccent">#FFFFFF</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.Surface2">#F3F5F8</Color>
    <Color x:Key="C.SurfaceHover">#E7EBF0</Color>
    <Color x:Key="C.Text">#1F2328</Color>
    <Color x:Key="C.TextMuted">#57606A</Color>
    <Color x:Key="C.TextSubtle">#8C959F</Color>
    <Color x:Key="C.Track">#E3E8EE</Color>
    <Color x:Key="C.Warn">#9A6700</Color>

    <SolidColorBrush x:Key="B.Accent" Color="#0969DA" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="#DDEBFB" />
    <SolidColorBrush x:Key="B.Bg" Color="#F4F6F9" />
    <SolidColorBrush x:Key="B.Border" Color="#D8DEE4" />
    <SolidColorBrush x:Key="B.Crit" Color="#CF222E" />
    <SolidColorBrush x:Key="B.Good" Color="#1A7F37" />
    <SolidColorBrush x:Key="B.Grid" Color="#ECEFF3" />
    <SolidColorBrush x:Key="B.High" Color="#BC4C00" />
    <SolidColorBrush x:Key="B.Info" Color="#0969DA" />
    <SolidColorBrush x:Key="B.Nav" Color="#EBEEF3" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Surface2" Color="#F3F5F8" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="#E7EBF0" />
    <SolidColorBrush x:Key="B.Text" Color="#1F2328" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#57606A" />
    <SolidColorBrush x:Key="B.TextSubtle" Color="#8C959F" />
    <SolidColorBrush x:Key="B.Track" Color="#E3E8EE" />
    <SolidColorBrush x:Key="B.Warn" Color="#9A6700" />
</ResourceDictionary>
