<Window x:Class="SQLDiskMonitor.Views.AzureSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SQLDiskMonitor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AzureSyncViewModel}"
        Title="Sync disks from Azure" Width="1120" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}" FontFamily="{StaticResource UiFont}">
    <Border Padding="24,20" Background="{DynamicResource B.Bg}">
    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Account}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource SoftButton}" Content="Sign in" Command="{Binding SignInCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" FontSize="19">
                    <Run Text="Sync disks from Azure · " /><Run Text="{Binding ServerName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                           Text="Reads the VM's managed disks, their tiers, limits and prices. Read-only; nothing in Azure is changed. Reader access is enough." />
            </StackPanel>
        </DockPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsMapStep, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource SoftButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource AccentButton}" Content="Load disks" Command="{Binding LoadDisksCommand}"
                        Visibility="{Binding IsVmStep, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource AccentButton}" Content="Apply to disks" Command="{Binding ApplyCommand}"
                        Visibility="{Binding IsMapStep, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding CopyLunScriptCommand}" Margin="0,0,12,0"
                    Visibility="{Binding IsMapStep, Converter={StaticResource BoolToVis}}"
                    ToolTip="A PowerShell script to run on the VM that maps each drive letter to its LUN, for exact matching">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Copy LUN script" />
                </StackPanel>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="3" Margin="0,0,12,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <Grid>
            <!-- Step 1: choose the VM -->
            <DockPanel Visibility="{Binding IsVmStep, Converter={StaticResource BoolToVis}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="VM resource ID or name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ResourceId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="Paste /subscriptions/…/virtualMachines/name, or find the VM below. SQL Server host:" />
                            <Run Text="{Binding HostName, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Find VMs" Command="{Binding LoadVmsCommand}" Margin="8,0,0,0" />
                            <Grid>
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource B.TextSubtle}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding VmView}" SelectedItem="{Binding SelectedVm}" Style="{StaticResource Table}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VM" Binding="{Binding Name}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Computer name" Binding="{Binding ComputerName}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding VmSize}" Width="150" />
                                <DataGridTextColumn Header="Resource group" Binding="{Binding ResourceGroup}" Width="*" />
                                <DataGridTextColumn Header="Subscription" Binding="{Binding SubscriptionName}" Width="*" />
                                <DataGridTextColumn Header="Region" Binding="{Binding Location}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Step 2: map disks to volumes -->
            <DockPanel Visibility="{Binding IsMapStep, Converter={StaticResource BoolToVis}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource Inset}" Margin="0,0,0,12">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SetCosts}" VerticalAlignment="Center">
                            <TextBlock><Run Text="Set monthly costs from Azure retail prices (" /><Run Text="{Binding Currency, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                        </CheckBox>
                        <TextBlock Text="{Binding VmSummary}" Style="{StaticResource Body}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="6,8,0,2" TextWrapping="Wrap"
                                   Text="Azure sets disk name, LUN, tier, IOPS and MB/s limits, burst, size, host caching and cost. Your label, drive name, notes and other tags are kept. Disks in a storage pool share a volume and their limits are added together." />
                        <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource Table}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Azure disk" Binding="{Binding Disk.Name}" IsReadOnly="True" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="LUN" Binding="{Binding Disk.LunText}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Disk.SkuText}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Tier" Binding="{Binding Disk.Tier}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Disk.SizeText}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="IOPS" Binding="{Binding Disk.Iops, StringFormat=N0}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="MB/s" Binding="{Binding Disk.Mbps, StringFormat=N0}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Cache" Binding="{Binding Disk.Caching}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Monthly" Binding="{Binding Disk.MonthlyPrice, StringFormat=N2}" IsReadOnly="True" Width="Auto" />
                                <DataGridTemplateColumn Header="Volume" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.VolumeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Matched by" Binding="{Binding Reason}" IsReadOnly="True" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
    </Border>
</Window>
