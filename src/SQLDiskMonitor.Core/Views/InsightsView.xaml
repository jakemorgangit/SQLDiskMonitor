<UserControl x:Class="SQLDiskMonitor.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SQLDiskMonitor.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:InsightsViewModel}">
    <UserControl.Resources>
        <Style x:Key="Count" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,16,0">
            <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,-12,0">
                <Border Style="{StaticResource Count}">
                    <StackPanel>
                        <TextBlock Text="CRITICAL" Style="{StaticResource Overline}" Foreground="{DynamicResource B.Crit}" />
                        <TextBlock Text="{Binding Critical}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Count}">
                    <StackPanel>
                        <TextBlock Text="HIGH" Style="{StaticResource Overline}" Foreground="{DynamicResource B.High}" />
                        <TextBlock Text="{Binding High}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Count}">
                    <StackPanel>
                        <TextBlock Text="MEDIUM" Style="{StaticResource Overline}" Foreground="{DynamicResource B.Warn}" />
                        <TextBlock Text="{Binding Medium}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Count}">
                    <StackPanel>
                        <TextBlock Text="ADVICE" Style="{StaticResource Overline}" Foreground="{DynamicResource B.Info}" />
                        <TextBlock Text="{Binding Other}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,10"
                       Visibility="{Binding Findings.Count, Converter={StaticResource NoValue}}"
                       Text="No findings for this period. Either all is well, or there isn't enough data yet." />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="10,0,0,10" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    <StackPanel Grid.Column="1" Margin="16,14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SeverityText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                            <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="  ·  " Style="{StaticResource Caption}" Visibility="{Binding Volume, Converter={StaticResource HasValue}}" />
                                            <TextBlock Text="{Binding Volume}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        <Border Style="{StaticResource Inset}" Padding="10,8" Margin="0,10,0,0" Visibility="{Binding Recommendation, Converter={StaticResource HasValue}}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource B.Accent}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Body}" FontSize="12.5" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Share this analysis" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                               Text="A tidy HTML or PDF report with a summary, disks, pressure heatmap, trend charts, findings, space and costs, for change requests or the infrastructure team." />
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Command="{Binding ExportReportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Create report…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="IO waits" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" Text="Time sessions spent waiting on storage, server-wide." />
                    <DataGrid ItemsSource="{Binding Waits}" Style="{StaticResource Table}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Wait" Binding="{Binding WaitType}" Width="*" />
                            <DataGridTextColumn Header="ms/s" Binding="{Binding AvgWaitMsPerSec, StringFormat=N1}" ElementStyle="{StaticResource NumCell}" />
                            <DataGridTextColumn Header="ms/wait" Binding="{Binding AvgMsPerWait, StringFormat=N2}" ElementStyle="{StaticResource NumCell}" />
                            <DataGridTextColumn Header="Peak" Binding="{Binding PeakWaitMsPerSec, StringFormat=N0}" ElementStyle="{StaticResource NumCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
