<UserControl x:Class="SQLDiskMonitor.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SQLDiskMonitor.Controls"
             xmlns:vm="clr-namespace:SQLDiskMonitor.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FilesViewModel}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Command="{Binding ExportCsvCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Export CSV" />
                </StackPanel>
            </Button>
            <Grid Width="300">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" VerticalContentAlignment="Center" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource B.TextSubtle}" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <ComboBox ItemsSource="{Binding VolumeFilter}" SelectedItem="{Binding SelectedVolume}" Width="160" Margin="10,0,0,0" />
            <TextBlock Text="{Binding Totals}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="8">
            <DataGrid ItemsSource="{Binding View}" Style="{StaticResource Table}" FrozenColumnCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="140" />
                    <DataGridTextColumn Header="File" Binding="{Binding Logical}" Width="150" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="56" />
                    <DataGridTextColumn Header="Disk" Binding="{Binding Volume}" Width="70" />
                    <DataGridTextColumn Header="Label" Binding="{Binding Disk}" Width="90" />
                    <DataGridTextColumn Header="LUN" Binding="{Binding Lun}" Width="46" />
                    <DataGridTextColumn Header="Size GB" Binding="{Binding SizeGb, StringFormat=N2}" ElementStyle="{StaticResource NumCell}" Width="76" />
                    <DataGridTextColumn Header="Used GB" Binding="{Binding UsedGb, StringFormat=N2}" ElementStyle="{StaticResource NumCell}" Width="76" />
                    <DataGridTextColumn Header="Used %" Binding="{Binding UsedPct, StringFormat=P0}" ElementStyle="{StaticResource NumCell}" Width="64" />
                    <DataGridTextColumn Header="Growth" Binding="{Binding Growth}" Width="80" />
                    <DataGridTextColumn Header="Read IOPS" Binding="{Binding ReadIops, StringFormat=N1}" ElementStyle="{StaticResource NumCell}" Width="82" />
                    <DataGridTextColumn Header="Write IOPS" Binding="{Binding WriteIops, StringFormat=N1}" ElementStyle="{StaticResource NumCell}" Width="84" />
                    <DataGridTextColumn Header="MB/s" Binding="{Binding Mbps, StringFormat=N2}" ElementStyle="{StaticResource NumCell}" Width="64" />
                    <DataGridTextColumn Header="Read ms" Binding="{Binding ReadLatency, StringFormat=N1}" ElementStyle="{StaticResource NumCell}" Width="70" />
                    <DataGridTextColumn Header="Write ms" Binding="{Binding WriteLatency, StringFormat=N1}" ElementStyle="{StaticResource NumCell}" Width="72" />
                    <DataGridTemplateColumn Header="Share of disk IO" Width="130" SortMemberPath="DiskIoShare">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0">
                                    <c:MeterBar Value="{Binding DiskIoShare}" Maximum="1" Fill="{DynamicResource B.Accent}" VerticalAlignment="Center" Margin="0,0,40,0" />
                                    <TextBlock Text="{Binding DiskIoShare, StringFormat=P0}" HorizontalAlignment="Right" FontSize="11.5" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Share of IO wait" Binding="{Binding StallShare, StringFormat=P1}" ElementStyle="{StaticResource NumCell}" Width="104" />
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" MinWidth="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
