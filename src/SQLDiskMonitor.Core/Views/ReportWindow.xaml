<Window x:Class="SQLDiskMonitor.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SQLDiskMonitor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ReportViewModel}"
        Title="Storage report" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource B.Surface}" Foreground="{DynamicResource B.Text}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24,20">
        <TextBlock Style="{StaticResource H1}" FontSize="19"><Run Text="Storage report · " /><Run Text="{Binding ServerName, Mode=OneWay}" /></TextBlock>
        <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Muted}" Margin="0,4,0,16" />

        <TextBlock Text="Format" Style="{StaticResource FieldLabel}" />
        <ListBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" Style="{StaticResource SegmentList}" HorizontalAlignment="Left" Margin="0,0,0,16" />

        <TextBlock Text="Include" Style="{StaticResource FieldLabel}" />
        <UniformGrid Columns="2" Margin="0,2,0,6">
            <UniformGrid.Resources>
                <Style TargetType="CheckBox" BasedOn="{StaticResource Switch}">
                    <Setter Property="Margin" Value="0,5" />
                </Style>
            </UniformGrid.Resources>
            <CheckBox Content="Summary" IsChecked="{Binding Options.Summary}" />
            <CheckBox Content="Disks" IsChecked="{Binding Options.Disks}" />
            <CheckBox Content="Pressure heatmap" IsChecked="{Binding Options.Heatmap}" />
            <CheckBox Content="Trend charts" IsChecked="{Binding Options.Charts}" />
            <CheckBox Content="Findings" IsChecked="{Binding Options.Findings}" />
            <CheckBox Content="Space and growth" IsChecked="{Binding Options.Space}" />
            <CheckBox Content="Costs" IsChecked="{Binding Options.Costs}" IsEnabled="{Binding CostsEnabled}" />
            <CheckBox Content="IO waits" IsChecked="{Binding Options.Waits}" />
            <CheckBox Content="Database files (appendix)" IsChecked="{Binding Options.Files}" />
        </UniformGrid>

        <CheckBox Style="{StaticResource Switch}" Content="Open when saved" IsChecked="{Binding OpenAfter}" Margin="0,10,0,0" />

        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Foreground="{DynamicResource B.Warn}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding Status, Converter={StaticResource HasValue}}" />

        <DockPanel Margin="0,20,0,0">
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="3" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SoftButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource AccentButton}" Command="{Binding GenerateCommand}" IsDefault="True"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save report…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
