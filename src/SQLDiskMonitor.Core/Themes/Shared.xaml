<!-- Resources every SQL Disk Monitor view needs besides the palette and Styles.xaml: converters, chart tracker,
     page view-model to view templates. Merged by App.xaml when standalone, and into the hosted root element
     (never Application.Resources) when another app hosts SQL Disk Monitor. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SQLDiskMonitor.Controls"
                    xmlns:vm="clr-namespace:SQLDiskMonitor.ViewModels"
                    xmlns:v="clr-namespace:SQLDiskMonitor.Views"
                    xmlns:oxy="http://oxyplot.org/wpf">
    <c:BoolToVisibility x:Key="BoolToVis" />
    <c:BoolToVisibility x:Key="BoolToVisInv" Invert="True" />
    <c:HasValueToVisibility x:Key="HasValue" />
    <c:HasValueToVisibility x:Key="NoValue" Invert="True" />
    <c:PressureToBrush x:Key="PressureBrush" />
    <c:SeverityToBrush x:Key="SeverityBrush" />
    <c:EnumEquals x:Key="EnumEquals" />
    <c:InverseBool x:Key="InverseBool" />
    <c:NotNullToVisibility x:Key="NotNull" />

    <Style x:Key="NumCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <ControlTemplate x:Key="ChartTracker">
        <oxy:TrackerControl Position="{Binding Position}" LineExtents="{Binding PlotModel.PlotArea}"
                            Background="{DynamicResource B.Surface2}" BorderBrush="{DynamicResource B.Border}"
                            LineStroke="{DynamicResource B.TextSubtle}" HorizontalLineVisibility="Collapsed" CornerRadius="6">
            <oxy:TrackerControl.Content>
                <TextBlock Text="{Binding}" Margin="10,6" FontSize="12" Foreground="{DynamicResource B.Text}" />
            </oxy:TrackerControl.Content>
        </oxy:TrackerControl>
    </ControlTemplate>
    <Style TargetType="oxy:PlotView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="DefaultTrackerTemplate" Value="{StaticResource ChartTracker}" />
    </Style>

    <!-- Page view-model to view mapping -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DisksViewModel}"><v:DisksView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MetricsViewModel}"><v:MetricsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PressureViewModel}"><v:PressureView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SpaceViewModel}"><v:SpaceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FilesViewModel}"><v:FilesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InsightsViewModel}"><v:InsightsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CostsViewModel}"><v:CostsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
</ResourceDictionary>
