<!-- Dark palette. Keys are referenced with DynamicResource so the theme can be switched at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="C.Accent">#58A6FF</Color>
    <Color x:Key="C.AccentSoft">#1A2F4D</Color>
    <Color x:Key="C.Bg">#0E1116</Color>
    <Color x:Key="C.Border">#2A313C</Color>
    <Color x:Key="C.Crit">#F85149</Color>
    <Color x:Key="C.Good">#3FB950</Color>
    <Color x:Key="C.Grid">#1F2630</Color>
    <Color x:Key="C.High">#F0883E</Color>
    <Color x:Key="C.Info">#58A6FF</Color>
    <Color x:Key="C.Nav">#0A0D11</Color>
    <Color x:Key="C.OnAccent">#0E1116</Color>
    <Color x:Key="C.Surface">#161B22</Color>
    <Color x:Key="C.Surface2">#1C222B</Color>
    <Color x:Key="C.SurfaceHover">#232B36</Color>
    <Color x:Key="C.Text">#E6EDF3</Color>
    <Color x:Key="C.TextMuted">#9DA7B3</Color>
    <Color x:Key="C.TextSubtle">#6E7681</Color>
    <Color x:Key="C.Track">#262D37</Color>
    <Color x:Key="C.Warn">#D29922</Color>

    <SolidColorBrush x:Key="B.Accent" Color="#58A6FF" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="#1A2F4D" />
    <SolidColorBrush x:Key="B.Bg" Color="#0E1116" />
    <SolidColorBrush x:Key="B.Border" Color="#2A313C" />
    <SolidColorBrush x:Key="B.Crit" Color="#F85149" />
    <SolidColorBrush x:Key="B.Good" Color="#3FB950" />
    <SolidColorBrush x:Key="B.Grid" Color="#1F2630" />
    <SolidColorBrush x:Key="B.High" Color="#F0883E" />
    <SolidColorBrush x:Key="B.Info" Color="#58A6FF" />
    <SolidColorBrush x:Key="B.Nav" Color="#0A0D11" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#0E1116" />
    <SolidColorBrush x:Key="B.Surface" Color="#161B22" />
    <SolidColorBrush x:Key="B.Surface2" Color="#1C222B" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="#232B36" />
    <SolidColorBrush x:Key="B.Text" Color="#E6EDF3" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#9DA7B3" />
    <SolidColorBrush x:Key="B.TextSubtle" Color="#6E7681" />
    <SolidColorBrush x:Key="B.Track" Color="#262D37" />
    <SolidColorBrush x:Key="B.Warn" Color="#D29922" />
</ResourceDictionary>
